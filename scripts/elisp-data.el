;;; elisp-data.el --- Emacs data for organ's elisp module  -*- lexical-binding: t -*-
;;;
;;; Usage:
;;;   emacs --batch -Q -l scripts/elisp-data.el \
;;;     --eval '(elisp-data-write "lua/organ/elisp/data")'
;;;   emacs --batch -Q -l scripts/elisp-data.el \
;;;     --eval '(elisp-data-dump-truth "/tmp/truth.txt")'
;;;   emacs --batch -Q -l scripts/elisp-data.el \
;;;     --eval '(elisp-data-dump-chars "/tmp/chars.txt")'
;;;
;;; `elisp-data-write' writes the Lua tables lua/organ/elisp/data/*.lua
;;; holds; tests/conformance/elisp/gate.lua regenerates them into a
;;; temporary directory and fails on any difference.
;;;
;;; - syntax_org.lua, syntax_elisp.lua: the syntax table of an org-mode
;;;   buffer and `emacs-lisp-mode-syntax-table', as ranges of code points
;;;   sharing one raw syntax descriptor (class plus flags) and matching
;;;   character.
;;; - errors.lua: `error-conditions' and `error-message' of every error
;;;   symbol of an Emacs with every profile's features loaded, and the
;;;   profiles whose features do not define it.
;;; - specials.lua: the names `special-variable-p' holds for in that Emacs.
;;; - functions.lua: for each special form, macro and builtin organ's
;;;   evaluator implements, its kind, the argument counts it accepts and
;;;   the head of its `wrong-number-of-arguments' data called directly
;;;   and through `funcall', all from live calls.
;;; - case.lua: `upcase', `downcase' and `capitalize' of every character
;;;   and of every code point's one-character string in an org-mode
;;;   buffer, where they change it.
;;; - width.lua: `char-width' in an org-mode buffer, the characters
;;;   `composition-function-table' holds a rule for, and those a CJK
;;;   locale's width table gives another width.
;;;
;;; `elisp-data-dump-truth' writes the same syntax tables one code point
;;; per line ("TABLE CODE MATCH", MATCH -1 for none), and
;;; `elisp-data-dump-chars' the case and width data one character per
;;; line, for the gate's check of organ's lookup functions.

(require 'org)

(defconst elisp-data-max-char #x10FFFF)

(defconst elisp-data-profiles
  '(("table" org)
    ("diary" org org-agenda diary-lib calendar)
    ("prefix" org org-agenda)
    ("capture" org org-capture)
    ("var" org ob-core)
    ("link" org ol))
  "Each evaluation profile and the features its Emacs entry point has loaded.")

(defconst elisp-data-functions
  '(quote function if cond and or progn prog1 let let* while condition-case
          when unless prog2 dolist dotimes lambda ignore-errors \` backquote
          funcall apply identity ignore error signal user-error
          cons list car cdr
          + - * / % mod 1+ 1- abs max min floor ceiling round truncate float
          ffloor fceiling fround ftruncate expt sqrt exp log sin cos tan asin
          acos atan isnan logand logior logxor lognot ash = /= < > <= >= zerop
          natnump numberp integerp floatp number-to-string string-to-number
          null not atom consp listp nlistp stringp symbolp vectorp sequencep
          functionp booleanp characterp keywordp eq eql equal
          concat substring string-to-char char-to-string string make-string
          string-to-list string-to-vector length string= string-equal string<
          string-lessp string> string-greaterp string-prefix-p string-suffix-p
          string-search string-replace string-empty-p string-blank-p upcase
          downcase capitalize upcase-initials string-trim string-trim-left
          string-trim-right split-string string-join mapconcat format
          symbol-name intern string-width
          truncate-string-to-width string-pad
          car-safe cdr-safe caar cadr cdar cddr nth nthcdr last butlast
          append vconcat nconc reverse nreverse member memq memql assoc assq
          rassoc rassq alist-get number-sequence mapcar mapc mapcan remove
          remq delete delq delete-dups sort aref elt seq-filter seq-remove
          seq-map seq-reduce seq-take seq-drop seq-uniq seq-contains-p
          seq-elt seq-first seq-rest seq-position)
  "Special forms, macros and builtins organ's evaluator implements.
`setq' is not listed: its odd-count check is not an argument count.")

(defconst elisp-data-max-args 7
  "Argument counts probed for each of `elisp-data-functions'.")

(defun elisp-data--tables ()
  (list (cons "org" (with-temp-buffer (org-mode) (syntax-table)))
        (cons "elisp" emacs-lisp-mode-syntax-table)))

(defun elisp-data--entry (table c)
  "Raw syntax descriptor and matching character of C in TABLE."
  (let ((e (aref table c)))
    (if (consp e)
        (cons (car e) (or (cdr e) -1))
      (cons 0 -1))))

(defun elisp-data--header (what)
  (format "-- Generated by scripts/elisp-data.el from GNU Emacs %s; do not edit.\n%s"
          emacs-version what))

(defun elisp-data--syntax-file (name table)
  (let ((prev nil) (rows nil))
    (dotimes (c (1+ elisp-data-max-char))
      (let ((e (elisp-data--entry table c)))
        (unless (equal e prev)
          (push (list c (car e) (cdr e)) rows)
          (setq prev e))))
    (concat
     (elisp-data--header
      (format "-- The %s syntax table as a flat array of ranges: [3k-2] is the\n-- range's first code point, [3k-1] its raw syntax descriptor (class\n-- plus flags) and [3k] its matching character or -1.  A range runs to\n-- the next one's first code point; the last runs to U+10FFFF.\n" name))
     "return {\n"
     (mapconcat (lambda (r) (format "  %d,\n  %d,\n  %d,\n" (nth 0 r) (nth 1 r) (nth 2 r)))
                (nreverse rows) "")
     "}\n")))

(defun elisp-data--lua-string (s)
  (concat "\""
          (mapconcat (lambda (c)
                       (cond ((memq c '(?\" ?\\)) (string ?\\ c))
                             ((or (< c 32) (= c 127)) (format "\\%03d" c))
                             (t (string c))))
                     s "")
          "\""))

(defun elisp-data--child (features form)
  "The value of FORM in a fresh Emacs that has loaded FEATURES."
  (with-temp-buffer
    (let ((status
           (call-process
            (expand-file-name invocation-name invocation-directory)
            nil '(t nil) nil "--batch" "-Q" "--eval"
            (format "(progn (mapc #'require '%S) (let ((print-escape-multibyte t) (print-escape-nonascii t) (print-length nil) (print-level nil)) (prin1 %S)))"
                    features form))))
      (unless (eq status 0)
        (error "elisp-data: child Emacs failed (%s): %s" status (buffer-string)))
      (car (read-from-string (buffer-string))))))

(defun elisp-data--all-features ()
  (delete-dups (apply #'append (mapcar #'cdr elisp-data-profiles))))

(defconst elisp-data--error-names-form
  '(let (l)
     (mapatoms (lambda (s) (when (get s 'error-conditions) (push (symbol-name s) l))))
     (sort l #'string<)))

(defun elisp-data--errors-file ()
  (let* ((all (elisp-data--child
               (elisp-data--all-features)
               `(mapcar (lambda (n)
                          (let ((s (intern n)))
                            (list n (mapcar #'symbol-name (get s 'error-conditions))
                                  (get s 'error-message))))
                        ,elisp-data--error-names-form)))
         (per-profile
          (mapcar (lambda (p)
                    (cons (car p) (elisp-data--child (cdr p) elisp-data--error-names-form)))
                  elisp-data-profiles)))
    (concat
     (elisp-data--header
      "-- Each error symbol's `error-conditions' and `error-message' in an\n-- Emacs with every profile's features loaded; `profiles' lists the\n-- profiles whose features define the symbol when not all do.\n")
     "return {\n"
     (mapconcat
      (lambda (e)
        (let ((in (delq nil (mapcar (lambda (p) (and (member (car e) (cdr p)) (car p)))
                                    per-profile))))
          (concat
           (format "  [%s] = {\n    conditions = { %s },\n"
                   (elisp-data--lua-string (nth 0 e))
                   (mapconcat #'elisp-data--lua-string (nth 1 e) ", "))
           (if (stringp (nth 2 e))
               (format "    message = %s,\n" (elisp-data--lua-string (nth 2 e)))
             "")
           (if (= (length in) (length per-profile))
               ""
             (format "    profiles = { %s },\n"
                     (mapconcat #'elisp-data--lua-string in ", ")))
           "  },\n")))
      all "")
     "}\n")))

(defun elisp-data--specials-file ()
  (concat
   (elisp-data--header
    "-- The names `special-variable-p' holds for in an Emacs with every\n-- profile's features loaded, sorted.\n")
   "return {\n"
   (mapconcat (lambda (n) (format "  %s,\n" (elisp-data--lua-string n)))
              (elisp-data--child
               (elisp-data--all-features)
               '(let (l)
                  (mapatoms (lambda (s) (when (special-variable-p s) (push (symbol-name s) l))))
                  (sort l #'string<)))
              "")
   "}\n"))

(defun elisp-data--kind (f)
  (let ((fn (indirect-function f)))
    (cond ((special-form-p fn) "special")
          ((macrop fn) "macro")
          ((subrp fn) "subr")
          (t "lisp"))))

(defun elisp-data--wna (form)
  "The `wrong-number-of-arguments' data FORM signals, or nil."
  (condition-case err
      (progn (eval form t) nil)
    (wrong-number-of-arguments (cdr err))
    (error nil)))

(defun elisp-data--lua-value (f x)
  "X as a Lua constructor: the subr of F, a symbol, an integer or a cons."
  (cond ((and (subrp x) (eq x (indirect-function f))) "{ subr = true }")
        ((symbolp x) (format "{ sym = %s }" (elisp-data--lua-string (symbol-name x))))
        ((integerp x) (number-to-string x))
        ((consp x) (format "{ car = %s, cdr = %s }"
                           (elisp-data--lua-value f (car x))
                           (elisp-data--lua-value f (cdr x))))
        (t (error "elisp-data: unencodable head %S of %s" x f))))

(defun elisp-data--function-entry (f)
  "F's kind, accepted argument counts and data heads, from live calls.
A count N is accepted when (F nil ... nil) with N arguments signals no
`wrong-number-of-arguments'; the accepted counts must form one range
and every refused count must give (HEAD N).  HEAD is the highest refused
count's; `heads' lists the refused counts whose head differs from it."
  (let* ((kind (elisp-data--kind f))
         (fn-p (member kind '("subr" "lisp")))
         min max heads fheads)
    (dotimes (n (1+ elisp-data-max-args))
      (let* ((args (make-list n nil))
             (direct (elisp-data--wna (cons f args)))
             (through (and fn-p (elisp-data--wna `(apply #'funcall ',f ',args)))))
        (if (null direct)
            (progn
              (when (and min (< (or max min) (1- n)))
                (error "elisp-data: %s accepts counts outside one range" f))
              (when through
                (error "elisp-data: %s refuses %d through funcall only" f n))
              (unless min (setq min n))
              (setq max n))
          (unless (and (consp (cdr direct)) (eql (cadr direct) n) (null (cddr direct)))
            (error "elisp-data: %s %d: unexpected data %S" f n direct))
          (push (cons n (car direct)) heads)
          (when fn-p
            (unless (and (consp (cdr through)) (eql (cadr through) n) (null (cddr through)))
              (error "elisp-data: %s %d: unexpected funcall data %S" f n through))
            (push (cons n (car through)) fheads)))))
    (unless min
      (error "elisp-data: %s accepts no count up to %d" f elisp-data-max-args))
    (let ((head (cdar heads)) (fhead (cdar fheads)))
      (concat
       (format "  [%s] = {\n    kind = %s,\n    min = %d,\n"
               (elisp-data--lua-string (symbol-name f))
               (elisp-data--lua-string kind) min)
       (if (< max elisp-data-max-args) (format "    max = %d,\n" max) "")
       (if head (format "    head = %s,\n" (elisp-data--lua-value f head)) "")
       (elisp-data--other-heads f "heads" heads head)
       (if fhead (format "    funcall_head = %s,\n" (elisp-data--lua-value f fhead)) "")
       (elisp-data--other-heads f "funcall_heads" fheads fhead)
       (if (function-get f 'compiler-macro) "    compiler_macro = true,\n" "")
       "  },\n"))))

(defun elisp-data--other-heads (f key heads common)
  "A Lua field KEY mapping each count of HEADS, (N . HEAD) pairs in
descending N, whose head is not COMMON to that head; empty when none."
  (let ((rows (delq nil (mapcar (lambda (h)
                                  (unless (equal (cdr h) common)
                                    (format "[%d] = %s" (car h)
                                            (elisp-data--lua-value f (cdr h)))))
                                (reverse heads)))))
    (if rows (format "    %s = { %s },\n" key (mapconcat #'identity rows ", ")) "")))

(defun elisp-data--functions-file ()
  (concat
   (elisp-data--header
    "-- Each implemented special form, macro and builtin: `kind' (special,\n-- macro, subr or lisp), the argument counts it accepts (`max' absent:\n-- no upper bound) and the head of its (wrong-number-of-arguments HEAD N)\n-- data called directly and, for functions, through `funcall' (`heads'\n-- and `funcall_heads': the counts whose head differs);\n-- `compiler_macro' when one rewrites its calls inside a closure.\n")
   "return {\n"
   (mapconcat #'elisp-data--function-entry
              (sort (copy-sequence elisp-data-functions)
                    (lambda (a b) (string< (symbol-name a) (symbol-name b))))
              "")
   "}\n"))

;; Characters: case mappings and display widths in an org-mode buffer

(defconst elisp-data-max-raw-char #x3FFFFF)

(defun elisp-data--canon (c)
  (or (aref (char-table-extra-slot (current-case-table) 1) c) c))

(defun elisp-data--cased (fn c)
  "FN of C and, for a Unicode C, of its one-character string:
(CHAR . STRING-OR-NIL), STRING-OR-NIL nil when the string result is the
character result's."
  (let ((ch (funcall fn c)))
    (cons ch (and (<= c elisp-data-max-char)
                  (let ((s (funcall fn (string c))))
                    (if (equal s (string ch)) nil s))))))

(defun elisp-data--case-maps ()
  "Vectors of each character's (CHAR . STRING) for upcase, downcase and
capitalize, checking the facts organ's case functions rely on."
  (let ((up (make-vector (1+ elisp-data-max-raw-char) nil))
        (down (make-vector (1+ elisp-data-max-raw-char) nil))
        (title (make-vector (1+ elisp-data-max-raw-char) nil)))
    (dotimes (c (1+ elisp-data-max-raw-char))
      (aset up c (elisp-data--cased #'upcase c))
      (aset down c (elisp-data--cased #'downcase c))
      (aset title c (elisp-data--cased #'capitalize c))
      (unless (eql (upcase-initials c) (car (aref title c)))
        (error "elisp-data: upcase-initials of %X is not capitalize's" c))
      (when (<= c elisp-data-max-char)
        (unless (equal (upcase-initials (string c))
                       (or (cdr (aref title c)) (string (car (aref title c)))))
          (error "elisp-data: upcase-initials of \"%c\" is not capitalize's" c))
        (let ((k (elisp-data--canon c)))
          (unless (eql k (downcase (upcase (downcase c))))
            (error "elisp-data: canon of %X is not downcase-upcase-downcase" c))
          (when (and (>= c 128) (< k 128))
            (error "elisp-data: non-ASCII %X folds to ASCII" c)))))
    (list up down title)))

(defun elisp-data--case-file ()
  (with-temp-buffer
    (org-mode)
    (let ((maps (elisp-data--case-maps))
          (names '("upcase" "downcase" "capitalize")))
      (concat
       (elisp-data--header
        "-- `upcase', `downcase' and `capitalize' in an org-mode buffer.  The\n-- first three are flat arrays of (character, result) pairs for each\n-- character up to #x3FFFFF the function maps to another; `special_*'\n-- maps a code point to the function's result on its one-character\n-- string where that is not the character result (Unicode's\n-- unconditional special casing).\n")
       "return {\n"
       (mapconcat
        (lambda (i)
          (let ((v (nth i maps)) (rows nil))
            (dotimes (c (length v))
              (let ((ch (car (aref v c))))
                (unless (eql ch c)
                  (push (format "    %d,\n    %d,\n" c ch) rows))))
            (concat "  " (nth i names) " = {\n" (apply #'concat (nreverse rows)) "  },\n")))
        '(0 1 2) "")
       (mapconcat
        (lambda (i)
          (let ((v (nth i maps)) (rows nil))
            (dotimes (c (length v))
              (let ((s (cdr (aref v c))))
                (when s
                  (push (format "    [%d] = %s,\n" c (elisp-data--lua-string s)) rows))))
            (concat "  special_" (nth i names) " = {\n" (apply #'concat (nreverse rows)) "  },\n")))
        '(0 1 2) "")
       "}\n"))))

(defun elisp-data--widths ()
  "Vectors of each code point's `char-width' in an org-mode buffer, whether
`composition-function-table' holds a rule for it, and whether its width
differs under a CJK locale's width table with ambiguous characters wide
or narrow."
  (let ((width (make-vector (1+ elisp-data-max-char) nil))
        (comp (make-vector (1+ elisp-data-max-char) nil))
        (cjk (make-vector (1+ elisp-data-max-char) nil)))
    (with-temp-buffer
      (org-mode)
      (use-default-char-width-table)
      (dotimes (c (1+ elisp-data-max-char))
        (aset width c (char-width c))
        (aset comp c (and (aref composition-function-table c) t)))
      (unwind-protect
          (dolist (slot cjk-char-width-table-list)
            (dolist (wide '(t nil))
              (let ((cjk-ambiguous-chars-are-wide wide))
                (update-cjk-ambiguous-char-widths (car slot))
                (dotimes (c (1+ elisp-data-max-char))
                  (unless (eql (char-width c) (aref width c))
                    (aset cjk c t))))))
        (dolist (slot cjk-char-width-table-list)
          (setcar (cdr slot) nil))
        (use-default-char-width-table)))
    (list width comp cjk)))

(defun elisp-data--ranges (v)
  "Flat (first, value) ranges of vector V."
  (let ((prev 'none) (rows nil))
    (dotimes (c (length v))
      (let ((x (aref v c)))
        (unless (equal x prev)
          (push (format "    %d,\n    %d,\n" c (cond ((eq x t) 1) ((null x) 0) (t x))) rows)
          (setq prev x))))
    (apply #'concat (nreverse rows))))

(defun elisp-data--width-file ()
  (let ((w (elisp-data--widths)))
    (concat
     (elisp-data--header
      "-- Display widths in an org-mode buffer, each a flat array of ranges:\n-- [2k-1] is the range's first code point and [2k] its value, the last\n-- range running to U+10FFFF.  `width' is `char-width'; `composition'\n-- is 1 where `composition-function-table' holds a rule for the\n-- character; `cjk' is 1 where a CJK locale's width table, with\n-- ambiguous characters wide or narrow, gives another width.\n")
     "return {\n"
     "  width = {\n" (elisp-data--ranges (nth 0 w)) "  },\n"
     "  composition = {\n" (elisp-data--ranges (nth 1 w)) "  },\n"
     "  cjk = {\n" (elisp-data--ranges (nth 2 w)) "  },\n"
     "}\n")))

(defun elisp-data--codes (s)
  (mapconcat (lambda (c) (format "%X" c)) s ","))

(defun elisp-data-dump-chars (file)
  "Write each code point's case and width data to FILE, one line each:
\"CODE UP DOWN TITLE CANON WIDTH COMPOSITION CJK SUP SDOWN STITLE\", the
string results as comma-separated hex code points, or \"=\" when the
one-character string maps as the character does.  Characters beyond
Unicode follow as \"CODE UP DOWN TITLE\" lines for those some mapping
changes, then \"end CODE\" naming the last character."
  (with-temp-buffer
    (let ((maps (with-temp-buffer (org-mode) (elisp-data--case-maps)))
          (w (elisp-data--widths))
          (canon (with-temp-buffer
                   (org-mode)
                   (let ((v (make-vector (1+ elisp-data-max-char) nil)))
                     (dotimes (c (length v)) (aset v c (elisp-data--canon c)))
                     v))))
      (dotimes (c (1+ elisp-data-max-raw-char))
        (let ((up (car (aref (nth 0 maps) c)))
              (down (car (aref (nth 1 maps) c)))
              (title (car (aref (nth 2 maps) c))))
          (cond
           ((<= c elisp-data-max-char)
            (insert (format "%d %d %d %d %d %d %d %d" c up down title (aref canon c)
                            (aref (nth 0 w) c) (if (aref (nth 1 w) c) 1 0)
                            (if (aref (nth 2 w) c) 1 0)))
            (dolist (m maps)
              (let ((s (cdr (aref m c))))
                (insert " " (if s (elisp-data--codes s) "="))))
            (insert "\n"))
           ((not (and (eql up c) (eql down c) (eql title c)))
            (insert (format "%d %d %d %d\n" c up down title))))))
      (insert (format "end %d\n" elisp-data-max-raw-char)))
    (let ((coding-system-for-write 'utf-8-unix))
      (write-region nil nil file))))

(defun elisp-data--write (file text)
  (let ((coding-system-for-write 'utf-8-unix))
    (with-temp-file file (insert text))))

(defun elisp-data-write (dir)
  "Write organ's elisp data tables into DIR."
  (make-directory dir t)
  (dolist (tbl (elisp-data--tables))
    (elisp-data--write (expand-file-name (format "syntax_%s.lua" (car tbl)) dir)
                       (elisp-data--syntax-file (car tbl) (cdr tbl))))
  (elisp-data--write (expand-file-name "errors.lua" dir) (elisp-data--errors-file))
  (elisp-data--write (expand-file-name "specials.lua" dir) (elisp-data--specials-file))
  (elisp-data--write (expand-file-name "functions.lua" dir) (elisp-data--functions-file))
  (elisp-data--write (expand-file-name "case.lua" dir) (elisp-data--case-file))
  (elisp-data--write (expand-file-name "width.lua" dir) (elisp-data--width-file)))

(defun elisp-data-dump-truth (file)
  "Write every code point's syntax under each table to FILE."
  (with-temp-buffer
    (dolist (tbl (elisp-data--tables))
      (dotimes (c (1+ elisp-data-max-char))
        (let ((e (elisp-data--entry (cdr tbl) c)))
          (insert (car tbl) " " (number-to-string (car e)) " "
                  (number-to-string (cdr e)) "\n"))))
    (let ((coding-system-for-write 'utf-8-unix))
      (write-region nil nil file))))

;;; elisp-data.el ends here
